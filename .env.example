DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tims?schema=public"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tims_test?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
# Production: 32+ random characters (not a placeholder), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_COOKIE_NAME="tims_session"
NODE_ENV="development"
# Public origin used in password-reset links (required in production).
APP_BASE_URL=""
# Standard application mailbox that sends password-reset emails to users.
MAIL_FROM="TIMS <noreply@etgroupindia.com>"
SMTP_HOST=""
SMTP_PORT="587"
# "true" for implicit TLS (port 465); leave empty/false for STARTTLS on 587.
SMTP_SECURE=""
SMTP_USER="noreply@etgroupindia.com"
SMTP_PASSWORD=""
# Only addresses on this domain can be registered or request a password reset.
COMPANY_EMAIL_DOMAIN="etgroupindia.com"
# Alternative to SMTP: HTTPS endpoint that accepts { from, to, subject, text } and sends the email.
MAIL_WEBHOOK_URL=""
# Hostnames/IPs other machines use to reach the dev server, comma separated (dev only).
ALLOWED_DEV_ORIGINS=""
# Optional: force the Secure cookie flag ("true"/"false"). Default: Secure only when served over HTTPS.
SESSION_COOKIE_SECURE=""
